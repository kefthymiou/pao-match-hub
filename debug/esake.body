<style>

@media(min-width:1600px){ 
    .team-header-path{
        position:relative;
        overflow:hidden;
    }
    .team-header-path::after{
        position:absolute;
        top:0px;
        right:0%;
        content:'';
        height:100%;
        min-height:100%;
        width:50%;
        background:url('/dat/esaketeam/00000001/team_photo_new_7ECD7392.jpg') 50% 50% no-repeat;
        background-size:cover;
    }
}
@media (min-width:990px) AND (max-width:1600px){ 
    .team-header-path{
        position:relative;
        overflow:hidden;
    }
    .team-header-path {
        background-size: 58.5%;
    }
    .team-header-path::after{
        position:absolute;
        top:0px;
        right:0%;
        content:'';
        height:100%;
        min-height:100%;
        width:41.6%;
        background:url('/dat/esaketeam/00000001/team_photo_new_7ECD7392.jpg') 50% 50% no-repeat;
        background-size:cover;
    }
    .team-path-rest-wrapper {
        padding-top: 20px;
        padding-bottom: 30px;
        bottom: -5px;
        
    }
    .team-path-name-title{
        top:10px;
    }
    .team-path-buttons {
        padding-top: 20px;
        padding-bottom: 20px;
    }
    
}
@media (min-width:768px) AND (max-width:990px){ 
    .team-header-path{
        position:relative;
        overflow:hidden;
    }
    .team-header-path {
        background-size:50%;
    }
    .team-header-path::after{
        position:absolute;
        top:0px;
        right:0%;
        content:'';
        height:100%;
        min-height:100%;
        width:50%;
        background:url('/dat/esaketeam/00000001/team_photo_new_7ECD7392.jpg') 50% 50% no-repeat;
        background-size:cover;
    }
    .team-path-rest-wrapper {
        padding-top: 20px;
        padding-bottom: 30px;
        bottom: -5px;
        
    }
    .team-path-buttons {
        padding-top: 20px;
        padding-bottom: 20px;
    }
    .team-path-name-title{
        top:10px;
    }

    .team-path-rest .team-path-rest-col,.team-path-rest .team-path-rest-col a.text-gold, .team-path-rest .team-path-rest-col a.text-gold:hover, .team-path-rest .team-path-rest-col a.text-gold:focus {
   
    font-size: 14px;
    }
}
    
@media (max-width:768px){
    .team-header-path {
        background-size:100%;
    }
    .team-header-path::after{
       display:none;
    }
    .team-path-buttons {
        padding-top: 20px;
        padding-bottom: 20px;
    }
    .team-path-photo-inner{
        background:url('/dat/esaketeam/00000001/team_photo_new_7ECD7392.jpg') 50% 50% no-repeat;
        background-size:cover;
        margin-left:-15px;
        margin-right:-15px;
    }
    .team-path-name-title-wrapper{
        height:130px;
    }
    .team-path-name-title{
        min-height:90px;
        top:10px;
    }
    .team-path-name-title span{
        font-size:24px;
        top:40px;
        transform:translateY(-40%);
    }
    .team-path-rest-wrapper {
    padding-top: 20px;
    padding-bottom: 20px;
    bottom: -5px;
}
}

</style>
